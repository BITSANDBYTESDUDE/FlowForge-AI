# ---------------------------------------------------------------------------
# FlowForge AI — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public base URL of the deployment (used for auth callbacks, links, emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# MongoDB connection string. Local dev: mongodb://localhost:27017/flowforge
# Production: a MongoDB Atlas SRV string.
MONGODB_URI=mongodb://localhost:27017/flowforge

# --- Authentication ---------------------------------------------------------
# 32+ byte random secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional: override the auth base URL (defaults to NEXT_PUBLIC_APP_URL).
BETTER_AUTH_URL=

# --- AI ---------------------------------------------------------------------
# Server-only. NEVER expose to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway.
OPENAI_BASE_URL=

# --- Rate limiting ----------------------------------------------------------
# Optional. Without these the app falls back to an in-memory limiter
# (fine for single-instance local development, NOT for serverless production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy aliases kept for compatibility with earlier deployment notes.
REDIS_URL=
REDIS_TOKEN=

# Rate limit configuration (requests per window, window in seconds).
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_API_REQUESTS=300
RATE_LIMIT_API_WINDOW_SECONDS=60

# --- Object storage (optional; used for avatars / attachments) ---------------
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Development / demo ------------------------------------------------------
# Enables `npm run seed`. Must NOT be enabled in production.
SEED_ENABLED=true
